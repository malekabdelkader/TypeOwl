{
  "name": "typeowl",
  "version": "0.1.0-beta.1",
  "description": "🦉 Runtime type synchronization between backend and frontend — types that fly across repos",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "typeowl": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malekelkader/typeowl.git"
  },
  "homepage": "https://typeowl.netlify.app",
  "bugs": {
    "url": "https://github.com/malekelkader/typeowl/issues"
  },
  "keywords": [
    "typescript",
    "types",
    "sync",
    "api",
    "backend",
    "frontend",
    "rpc",
    "codegen",
    "zod",
    "type-safety",
    "monorepo"
  ],
  "author": "Malek Abdelkader",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "zod": "^4.3.5"
  },
  "dependencies": {
    "ts-morph": "^27.0.2"
  },
  "peerDependencies": {
    "zod": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  }
}
