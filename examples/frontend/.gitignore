# Dependencies
node_modules/

# Build output
dist/

# ═══════════════════════════════════════════════════════════════════════════════
# 🦉 TypeOwl - Type Management
# ═══════════════════════════════════════════════════════════════════════════════
#
# RECOMMENDED: Commit .typeowl/ for independent deploys and guaranteed compatibility
# Only gitignore the cache directory
#
# Why commit types?
# ✅ Types match the API version when code was written
# ✅ CI/CD builds work without backend access
# ✅ Frontend devs can clone and run immediately
# ✅ Independent deploys - backend changes don't break frontend builds
# ✅ Type changes are visible in code reviews
#
# Alternative: Gitignore both for always-latest types (requires backend access)
# .typeowl/
# .typeowl-cache/
# ═══════════════════════════════════════════════════════════════════════════════

# Cache only - types are committed for CI builds and independent deploys
.typeowl-cache/

# Vite
*.local

# Logs
*.log

